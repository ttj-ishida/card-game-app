{
  "name": "card-game-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:link": "supabase link --project-ref evzmtxwdsoebekxlqxeo",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:format:check": "npm --prefix apps/mobile run format:check",
    "assets:generate": "node scripts/generate-m0-card-placeholders.mjs",
    "assets:check": "node scripts/check-m0-assets.mjs",
    "ui:test": "npm --prefix apps/mobile exec -- tsx --test packages/ui/src/tokens.test.ts",
    "ui:typecheck": "npm --prefix apps/mobile exec -- tsc --noEmit --project packages/ui/tsconfig.json"
  },
  "devDependencies": {
    "supabase": "^2.116.0"
  }
}
